{
  "name": "backyard-bbq-king",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev -w @bbq/web",
    "dev:admin": "npm run dev -w @bbq/admin",
    "dev:api": "npm run dev -w @bbq/api",
    "dev:workers": "npm run dev -w @bbq/workers",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "analyze": "cross-env ANALYZE=true turbo run build --filter=@bbq/web"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
