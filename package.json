{
  "name": "backyard-bbq-king",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev -w @bbq/web",
    "dev:admin": "npm run dev -w @bbq/admin",
    "dev:api": "npm run dev -w @bbq/api",
    "dev:workers": "npm run dev -w @bbq/workers",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:all": "concurrently -n web,api,admin \"npm run typecheck -w @bbq/web\" \"npm run typecheck -w @bbq/api\" \"npm run typecheck -w @bbq/admin\"",
    "validate:admin": "npm run typecheck -w @bbq/admin && npm run verify:roles -w @bbq/admin && npm run verify:dashboard-pages -w @bbq/admin && npm run verify:api-roles -w @bbq/admin",
    "validate:admin:fast": "concurrently -n roles,pages,api \"npm run verify:roles -w @bbq/admin\" \"npm run verify:dashboard-pages -w @bbq/admin\" \"npm run verify:api-roles -w @bbq/admin\"",
    "validate:payments:core": "npm test -- --runInBand && npm run test:payments:scripts && npm run typecheck -w @bbq/web && npm run typecheck -w @bbq/api && npm run typecheck -w @bbq/admin && npm run verify:api-roles -w @bbq/admin && npm run test:payments:coverage",
    "validate:pre-push": "npm test && npm run test:integration:scripts && npm run typecheck:all && npm run validate:admin:fast",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:payments:coverage": "jest --config jest.payments.config.js --coverage --runInBand",
    "test:payments:scripts": "node --test scripts/__tests__/payments-integration-summary.test.mjs scripts/__tests__/payments-integration-checks.test.mjs",
    "test:delivery:scripts": "node --test scripts/__tests__/delivery-integration-checks.test.mjs scripts/__tests__/delivery-integration-summary.test.mjs",
    "test:integration:scripts": "npm run test:payments:scripts && npm run test:delivery:scripts",
    "test:payments:integration": "node scripts/payments-integration-checks.mjs",
    "test:delivery:integration": "node scripts/delivery-integration-checks.mjs",
    "test:delivery:webhook-replay": "npm run test:delivery:webhook-replay -w @bbq/api --",
    "test:delivery:status-replay": "npm run test:delivery:status-replay -w @bbq/api --",
    "test:delivery:dispatch-replay": "npm run test:delivery:dispatch-replay -w @bbq/api --",
    "test:delivery:action-replay": "npm run test:delivery:action-replay -w @bbq/api --",
    "test:delivery:settlement-replay": "npm run test:delivery:settlement-replay -w @bbq/api --",
    "test:delivery:contract-replay": "npm run test:delivery:contract-replay -w @bbq/api --",
    "report:payments:integration": "node scripts/payments-integration-summary.mjs",
    "report:delivery:integration": "node scripts/delivery-integration-summary.mjs",
    "report:delivery:integration:all": "node scripts/delivery-integration-summary.mjs --all-channels true --require-files true --require-pass true",
    "report:payments:coverage": "node scripts/payments-coverage-summary.mjs",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:stripe:webhook-replay": "npm run test:stripe:webhook-replay -w @bbq/api --",
    "test:stripe:dispute-replay": "npm run test:stripe:dispute-replay -w @bbq/api --",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep-invert @auth",
    "test:e2e:auth": "playwright test --grep @auth",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "cross-env ANALYZE=true turbo run build --filter=@bbq/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.1",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
