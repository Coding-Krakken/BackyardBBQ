#!/bin/sh

# Pre-push hook: Run fast validation before pushing to remote
# Optimized for speed - runs tests in parallel, skips coverage, E2E optional

echo "🔍 Running pre-push validation (optimized)..."
echo ""

# Fast validation: tests (no coverage) + parallel typechecks + admin checks
echo "⚡ Running fast validation suite..."
npm run validate:pre-push
if [ $? -ne 0 ]; then
  echo "❌ Validation failed"
  exit 1
fi
echo "✅ Fast validation passed"
echo ""

# Optional E2E smoke tests - set SKIP_E2E=1 to skip
if [ "$SKIP_E2E" = "1" ]; then
  echo "⏭️  Skipping E2E tests (SKIP_E2E=1)"
else
  echo "🧪 Running E2E smoke tests..."
  npm run test:e2e:smoke
  if [ $? -ne 0 ]; then
    echo "❌ E2E smoke tests failed"
    echo "💡 To skip E2E tests: SKIP_E2E=1 git push"
    exit 1
  fi
  echo "✅ E2E smoke tests passed"
fi
echo ""

echo "✨ All pre-push validations passed! Pushing to remote..."
